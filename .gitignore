# Dependencies
node_modules/
.npm-cache/
# pnpm content-addressable store (created when running in sandbox mode)
.pnpm-store/
# Build output
dist/

# v1 store and host logs
store/
logs/

# === Per-install state (tracked) ===
# `groups/` and `data/dumps/` are tracked on this install's `origin` remote
# (businesslifers/janet-v2) for disaster recovery. Per-group identity (personas,
# memory, wiki, configs, agent scripts) lives there. Live DB, sessions, raw
# source material, credentials, and runtime artefacts are excluded below.

# --- groups/ exclusions ---
# Raw source material (chat transcripts, ingested PDFs, etc.) — out of scope
# for the install repo: large, may contain PII, distilled content lives in wiki/.
groups/*/sources/

# Live credentials — must never be pushed. Real keys live in OneCLI vault.
groups/*/credentials/
groups/*/.env
groups/*/.env*

# Build artefacts and dependencies under groups/
groups/*/node_modules/
groups/*/.pnpm-store/
groups/*/.pnpm-cache/
groups/*/dist/

# Runtime / regenerable per-agent data
groups/*/data/raw/
groups/*/data/analysis/
groups/*/data/reports/
groups/*/data/*.log
groups/*/data/api-test-result.txt
groups/*/data/ga4-test-result.txt
groups/*/data/collector-status.json

# Per-session working screenshots (agent-browser / Miro browsing artefacts)
groups/*/miro_*.png

# Composer-managed CLAUDE.md artefacts (regenerated each container spawn)
groups/*/CLAUDE.md
groups/*/.claude-shared.md
groups/*/.claude-fragments/

# --- data/ exclusions ---
# Live central DB and SQLite WAL/SHM transient state.
# Identity is tracked separately as text dumps under data/dumps/ via
# scripts/dump-central-db.sh — run before commits that should snapshot state.
data/v2.db
data/v2.db-shm
data/v2.db-wal

# Per-session DBs (inbound.db / outbound.db / .heartbeat) — churn rapidly,
# regenerate as messages flow in after restore.
data/v2-sessions/

# Runtime / sockets / secrets
data/circuit-breaker.json
data/cli.sock
data/env/
data/telegram-pairings.json

# === Generic ===
# Secrets
*.keys.json
.env
.env*

# Temp files
.tmp-*

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Skills system (local per-installation state)
.nanoclaw/

agents-sdk-docs

# Superpowers brainstorming visual-companion working files
.superpowers/
